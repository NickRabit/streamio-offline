STREMIO_OFFLINE_PORT=8090
DOWNLOAD_PATH=./downloads
# Data serveru: účet, doplňky, náhledy knihovny a statistiky. Na Synology sem
# dejte cestu do sdílené složky, ať je vidět ve File Stationu a zálohuje se.
DATA_PATH=./data
TZ=Europe/Prague
# Pod kterým uživatelem má běžet. Na Synology zjistíte vlastníka složky
# v Container Manageru: terminál kontejneru, příkaz  ls -n /downloads
PUID=1000
PGID=1000
# Jednorázově přepíše vlastníka celé složky se stahováním. U velké knihovny to trvá.
FIX_PERMISSIONS=0
# Povolení konkrétního vlastního doplňku v LAN. Bezpečnější než otevřít celou síť.
# ALLOW_ADDON_HOSTS=192.168.1.50,nas.local
# Otevře celou privátní síť. Zapínejte jen když víte proč.
ALLOW_PRIVATE_ADDONS=0
# Volitelné ladění převodu (nižší CRF = vyšší kvalita a zátěž).
# Uplatní se jen tam, kde se video skutečně překóduje.
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_READRATE=1.5
# Náskok při pouhém přebalení; vyšší hodnota zrychlí posun po časové ose.
FFMPEG_READRATE_REMUX=3
# Hardwarový převod přes Intel QuickSync: spusťte s override souborem
#   docker compose -f compose.yml -f compose.synology.yml up -d --build
# V Container Manageru, který override nepodporuje, odkomentujte místo toho blok
# devices v compose.yml a nastavte obě hodnoty níž.
# VAAPI_DEVICE=/dev/dri/renderD128
# GID skupiny vlastnící /dev/dri/renderD128 (v terminálu kontejneru: ls -n /dev/dri,
# na NASu: stat -c "%g" /dev/dri/renderD128). Bez něj proces na zařízení nedosáhne.
# Výchozích 937 odpovídá skupině videodriver na DSM 7.
# RENDER_GID=937
