STREMIO_OFFLINE_PORT=8090
DOWNLOAD_PATH=./downloads
TZ=Europe/Prague
# Zapněte pouze pokud vědomě instalujete doplněk z vlastní LAN.
ALLOW_PRIVATE_ADDONS=0
# Volitelné ladění převodu (nižší CRF = vyšší kvalita a zátěž).
# Uplatní se jen tam, kde se video skutečně překóduje.
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_READRATE=1.5
# Náskok při pouhém přebalení; vyšší hodnota zrychlí posun po časové ose.
FFMPEG_READRATE_REMUX=8
# Hardwarový převod přes Intel QuickSync. Vyžaduje odkomentovat devices v compose.yml.
# VAAPI_DEVICE=/dev/dri/renderD128
